# Node.js 24+ / values stay on the server. Never put API keys in index.html.
HOST=127.0.0.1
PORT=4180
PUBLIC_ORIGIN=http://127.0.0.1:4180
DATABASE_PATH=./data/business-assistant.sqlite

# https://www.bizinfo.go.kr/apiDetail.do?id=bizinfoApi
BIZINFO_API_KEY=
BIZINFO_PAGE_SIZE=100
BIZINFO_MAX_PAGES=100
REQUEST_TIMEOUT_MS=20000
REQUEST_RETRIES=2

# npm run setup generates a random token in .env. Do not publish it.
ADMIN_TOKEN=

# The server must remain running. A missed run executes after restart.
SYNC_ENABLED=true
SYNC_INTERVAL_HOURS=24
SYNC_RETRY_MINUTES=60
